<resources>
    <style name="Theme.Morphont.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- No bar colours here: statusBarColor/navigationBarColor are deprecated on API 35.
             MainActivity.enableEdgeToEdge() owns the bars; screens pad themselves with system-bar insets. -->
        <item name="android:windowBackground">@color/morphont_ground</item>
        <item name="android:colorAccent">@color/morphont_primary</item>
    </style>

    <style name="Theme.Morphont" parent="Theme.Morphont.Base">
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>
</resources>
